+def _wrap(tool_text: str, content_after: str = "") -> str:
+    """Wrap pythonic tool call in LFM2.5 sentinel tokens."""
+    result = f"{TOOL_CALL_START}[{tool_text}]{TOOL_CALL_END}"
+    if content_after:
+        result += f"\n{content_after}"
+    return result
