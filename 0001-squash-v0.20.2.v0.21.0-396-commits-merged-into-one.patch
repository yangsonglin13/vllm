+    n_rows = S * H
+
+    if block_m is None or block_n is None or num_warps is None:
+        block_m, block_n, num_warps = _get_fp8_pad_quant_config(padded_head_dim)
+
+    grid = (
+        triton.cdiv(n_rows, block_m),
+        triton.cdiv(padded_head_dim, block_n),
+    )
